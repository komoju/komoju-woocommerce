#!/bin/bash

set -euo pipefail

SLUG=komoju-japanese-payments
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD_DIR="$(mktemp -d)"
trap 'rm -rf "$BUILD_DIR"' EXIT

cd "$REPO_ROOT"
rm -f "$SLUG.zip"

STAGE="$BUILD_DIR/$SLUG"
mkdir -p "$STAGE"

if [[ "${1:-}" == "--dirty" ]]; then
	rsync -a --exclude '.git' ./ "$STAGE/"
else
	git archive HEAD | tar -x -C "$STAGE"
fi

while IFS= read -r pattern; do
	case $pattern in '' | \#*) continue ;; esac
	rm -rf "$STAGE/${pattern#/}"
done < .distignore

( cd "$BUILD_DIR" && zip -rq "$REPO_ROOT/$SLUG.zip" "$SLUG" -x '*.DS_Store' )

echo "✓ $SLUG.zip ($(du -h "$SLUG.zip" | cut -f1))"
